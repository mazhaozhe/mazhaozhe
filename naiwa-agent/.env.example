# ============================================================
# 复制本文件为 .env 并填写真实值：  cp .env.example .env
# 注意：.env 含密钥，已被 .gitignore 排除，切勿提交到仓库
# ============================================================

# 【必填】DeepSeek API Key，申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 模型配置 ----
# 主力模型：日常对话 + 工具调用（性价比高）
MAIN_MODEL=deepseek-chat
# 深度推理模型：复杂任务时使用（回答前会深度思考）
REASONER_MODEL=deepseek-reasoner
# API 地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 温度：工具调用场景建议低温（0~0.3），减少幻觉
TEMPERATURE=0.2
# 反"复读机"采样参数（0~2，0=关闭）：
# 模型卡在"该选 A 还是 B"时会退化成「好。执行。好。执行。」的死循环，
# frequency_penalty 按词频惩罚已出现过的 token，是最直接的压制手段。
FREQUENCY_PENALTY=0.3
PRESENCE_PENALTY=0.1

# ---- 安全阀（防止无限循环白耗 token）----
# 单次任务最大模型调用次数（复杂长任务被中途截断时调大）
MODEL_RUN_LIMIT=60
# 单次任务最大工具调用次数
TOOL_RUN_LIMIT=100

# ---- 可靠性 ----
# 工具失败自动重试次数（指数退避）
# 工具失败自动重试次数（只对网络类瞬时异常生效；命令超时、参数错误不重试）
TOOL_RETRIES=3

# ---- 限流（减小开销）----
# 每分钟最大工具调用次数
CALLS_PER_MINUTE=60
# 最大并发数
MAX_CONCURRENCY=4

# ---- 长对话上下文压缩（原会话内凝练，任务不中断）----
# 压缩触发点优先按"模型窗口预算"自动计算：窗口 - 最大输出 - 静态开销 - 安全余量。
# 模型窗口数据写在 config/models.json 的 max_input_tokens / max_output_tokens，
# 换大窗口模型（/use 热切换）时触发点自动跟着抬高。
# 下面几项是兜底与微调：
# 窗口未知的模型（如自动发现）用这个绝对阈值触发压缩
SUMMARIZE_TRIGGER_TOKENS=16000
# 压缩时保留最近多少条原文消息（保证上下句衔接）
SUMMARIZE_KEEP_MESSAGES=20
# 预算公式里的安全余量（token），防止请求顶满窗口
SUMMARIZE_SAFETY_MARGIN=8192
# 喂给摘要模型的历史上限；0 = 不裁剪
# （推荐 0：历史开头是原始任务目标，裁剪会丢目标）
SUMMARIZE_TRIM_TOKENS=0

# ---- RAG 知识库（可选，需安装 requirements-rag.txt）----
# true 开启 / false 关闭（关闭时不加载 RAG 工具）
RAG_ENABLED=false
# 检索返回的最相关片段数
RAG_TOP_K=4
# 向量库持久化目录
CHROMA_DIR=data/chroma

# ---- 会话与数据目录 ----
CHECKPOINT_DB=data/checkpoint.sqlite
CACHE_DB=data/cache.sqlite
LOG_FILE=data/agent.log
# 完整思考/工具过程流水（/trace 命令打开的文件）
TRACE_FILE=data/trace.log

# ---- 附件上传（客户端上传文件 / 照片）----
# 附件根目录：staging 暂存 + <session_id> 归档（删除即重置）
UPLOAD_DIR=data/uploads
# 单附件大小上限（MB）
UPLOAD_MAX_MB=10
# 文本类附件注入对话的最大字符数（超出截断，完整文件仍在磁盘上）
UPLOAD_TEXT_CHARS=20000

# ---- 视觉（图片识别）能力 ----
# 模型 id 命中这些子串即视为"支持图片输入"（逗号分隔，可自行增删）。
# 覆盖 qwen-vl / moonshot vision / gpt-4o / gemini / claude-3 等常见命名；
# config/models.json 里也可给单条模型显式写 supports_vision: true/false 覆盖。
VISION_PATTERNS=vl,vision,qvq,4o,gemini,pixtral,llava,internvl,claude-3

# ---- 单次任务超时（秒）----
# 客户端 send_message 的硬超时：模型接口挂起时自动取消该轮任务，
# 客户端输入框立即恢复（防止"开启新对话后无法打字"的锁死）。
# 0 = 不限制
RUN_TIMEOUT_SECONDS=900

# ---- 输出退化护栏（防"复读机"）----
# 流式检测到模型陷入重复循环时立刻中止生成，避免把 max_tokens 烧光
# （实测一次退化能白烧 3.4 万 tokens 且不产生任何结果）。
DEGENERATE_GUARD=true
# 中止后自动重试一轮（附带"别再权衡，立刻动手"的纠正指令）；0 = 不重试
DEGENERATE_RETRY=1

# ---- 过程框 UI ----
# 思考与工具过程框的内容行数（过程只显示最近 N 行，完整过程看 /trace）
PROCESS_BOX_LINES=10
